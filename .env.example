# Copy to .env and fill from local/important stuff/. Never commit .env.

# Staging API base URL
SCORYBOARD_API_BASE=

# Admin API key, sent as X-API-KEY. Source: local/important stuff/api key.txt
SCORYBOARD_ADMIN_API_KEY=

# Intercom access token, sent as Authorization: Bearer
INTERCOM_ACCESS_TOKEN=

# owner/repo the screenshot URLs are built from
GITHUB_REPO=

# --- Needed by the token-minting flow, not in the original brief ---

# Staging web app base URL, for Playwright
SCORYBOARD_APP_BASE=

# Firebase Web API key for staging, to exchange a custom token for an ID token.
# TODO: confirm this value. It is not in the Postman collection.
FIREBASE_WEB_API_KEY=

# --- Collection 01 only ---

# Password used by every collection-01 account. Collection 01 is the only one
# that photographs signing up, signing in and resetting a password, so it is the
# only one whose accounts need one. Throwaway staging accounts; the seed script
# sets it. Anything Firebase accepts (6 characters minimum) works.
KB01_PASSWORD=
