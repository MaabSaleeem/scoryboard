      "intercom_id": "string - Intercom article id, the key for idempotent re-publish",
      "collection": "string - collection id, e.g. \"07\"",
      "intercom_collection_id": "string - from config/intercom.yaml",
      "brief": "string - path to the approved brief",
      "spec": "string - path to the Playwright spec that captured it",
      "commit_sha": "string - the commit the screenshot URLs are pinned to",
      "screenshots": "string[] - screenshot paths, in article order, with content hashes",
      "published_at": "string - ISO 8601",
      "status": "string - published | needs_recapture | retired"
    },
    "example": {
